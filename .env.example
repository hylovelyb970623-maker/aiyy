# 服务端口（Docker Nginx 对外端口）
PORT=80

# ComfyUI 地址（本机部署时用 host.docker.internal，按需修改）
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_WS_URL=ws://host.docker.internal:8188

# JWT 密钥：务必改成你自己的随机长字符串
JWT_SECRET=please-change-me-to-a-long-random-string

# 初始管理员账号（首次启动自动创建），务必改成你自己的
ADMIN_ACCOUNT=admin@example.com
ADMIN_PASSWORD=admin123

# 积分默认值
DEFAULT_CREDITS_ON_SIGNUP=100
DEFAULT_CREDITS_PER_RUN=1
